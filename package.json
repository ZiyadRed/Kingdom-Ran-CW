{
  "name": "kingdom-ran-en",
  "version": "0.1.0",
  "description": "RanHQ – multilingual Kingdom Ran archive, team planning and Castle War tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "sync:star6": "node scripts/sync_star6.mjs",
    "validate:cw6": "node scripts/validate_cw6.mjs",
    "validate:i18n": "node scripts/localization/validate_catalogs.mjs",
    "prebuild": "node scripts/generate_sitemap.mjs && node scripts/sync_star6.mjs && node scripts/validate_cw6.mjs && node scripts/localization/validate_catalogs.mjs",
    "build": "vite build && node scripts/prerender.mjs && node scripts/validate_seo.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:seo": "node scripts/validate_seo.mjs",
    "lint": "eslint src scripts tests/browser *.config.js .eslintrc.cjs --ext js,jsx,mjs,cjs --report-unused-disable-directives --max-warnings 0",
    "validate:source": "node scripts/localization/validate_source_map.mjs && node scripts/localization/validate_locale_artifacts.mjs",
    "preview:built": "node scripts/serve-built.mjs",
    "test:browser": "playwright test",
    "check:release": "npm run lint && npm run validate:source && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "i18next": "^26.3.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "vite": "8.0.16",
    "vitest": "^4.1.7"
  }
}
